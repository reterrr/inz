// X(Tag, NodeKindCase, AstPtrType, AllocFuncName, FillFuncName)

X(Module,       NodeKind::Decl_Module,      ast::Module*,              alloc_module,        fill_module)
X(Import,       NodeKind::Decl_Import,      ast::ImportDecl*,          alloc_import,        fill_import)

X(FnDecl,       NodeKind::Decl_Fn,          ast::FnDecl*,        alloc_fndecl,        fill_fndecl)
X(LoadFnDecl,   NodeKind::Decl_LoadFn,      ast::LoadFnDecl*,    alloc_loadfndecl,    fill_loadfndecl)
X(ImplFnDecl,   NodeKind::Decl_ImplFn,      ast::ImplFnDecl*,    alloc_impl_fndecl,    fill_impl_fndecl)
X(TraitFnDecl,  NodeKind::Decl_TraitFn,     ast::TraitFnDecl*,   alloc_trait_fndecl,   fill_trait_fndecl)
X(StructDecl,   NodeKind::Decl_Struct,      ast::StructDecl*,          alloc_struct,        fill_structdecl)
// X(TypeAlias,    NodeKind::Decl_TypeAlias,   ast::TypeAliasDecl*,        alloc_typealias,     fill_typealias)
X(ParamDecl,    NodeKind::Decl_Param,       ast::ParamDecl*,           alloc_param,         fill_param)
X(FieldDecl,    NodeKind::Decl_Field,       ast::FieldDecl*,           alloc_field_decl,         fill_field_decl)
X(TypeParam,    NodeKind::Decl_TypeParam,   ast::TypeParamDecl*,       alloc_type_param,     fill_type_param)
X(TraitDecl,    NodeKind::Decl_Trait,       ast::TraitDecl*,           alloc_trait_decl,     fill_trait_decl)
X(ImplDecl,     NodeKind::Decl_Impl,        ast::ImplDecl*,            alloc_impl_decl,      fill_impl_decl)
X(SelfParamDecl, NodeKind::Decl_SelfParam,  ast::SelfParamDecl*,       alloc_self_param_decl, fill_self_param_decl)



X(BlockStmt,    NodeKind::Stmt_Block,       ast::BlockStatement*,      alloc_stmt_block,    fill_stmt_block)
X(IfStmt,       NodeKind::Stmt_If,          ast::IfStatement*,         alloc_stmt_if,       fill_stmt_if)
X(ElseIfStmt,   NodeKind::Stmt_ElseIf,      ast::ElseIfStatement*,     alloc_stmt_elseif,   fill_stmt_elseif)
X(WhileStmt,    NodeKind::Stmt_While,       ast::WhileStatement*,      alloc_stmt_while,    fill_stmt_while)
X(DoWhileStmt,  NodeKind::Stmt_DoWhile,     ast::DoWhileStatement*,    alloc_stmt_dowhile,  fill_stmt_dowhile)
X(ReturnStmt,   NodeKind::Stmt_Return,      ast::ReturnStatement*,     alloc_stmt_return,   fill_stmt_return)
X(VarStmt,      NodeKind::Stmt_Var,         ast::VarStmt*,             alloc_stmt_var,      fill_stmt_var)
X(ExprStmt,     NodeKind::Stmt_Expr,        ast::ExprStatement*,       alloc_stmt_expr,     fill_stmt_expr)
X(BreakStmt,    NodeKind::Stmt_Break,       ast::BreakStatement*,      alloc_stmt_break,    fill_stmt_break)
X(ContinueStmt, NodeKind::Stmt_Continue,    ast::ContinueStatement*,   alloc_stmt_continue, fill_stmt_continue)
X(ElseStmt,     NodeKind::Stmt_Else,        ast::ElseStatement*,       alloc_stmt_else,     fill_stmt_else)


X(PathExpr,     NodeKind::Expr_Path,        ast::PathExpr*,            alloc_expr_path,     fill_expr_path)
X(CallExpr,     NodeKind::Expr_Call,        ast::CallExpr*,            alloc_expr_call,     fill_expr_call)

X(CastExpr,     NodeKind::Expr_Cast,        ast::CastExpr*,            alloc_expr_cast,     fill_expr_cast)
X(UnaryExpr,    NodeKind::Expr_Unary,       ast::UnaryExpr*,           alloc_expr_unary,    fill_expr_unary)
X(BinaryExpr,   NodeKind::Expr_Binary,      ast::BinaryExpr*,          alloc_expr_binary,   fill_expr_binary)
X(AssignExpr,   NodeKind::Expr_Assign,      ast::AssignExpr*,          alloc_expr_assign,   fill_expr_assign)
X(IndexExpr,    NodeKind::Expr_Index,       ast::IndexExpr*,           alloc_expr_index,    fill_expr_index)
X(FieldExpr,    NodeKind::Expr_Field,       ast::FieldExpr*,           alloc_expr_field,    fill_expr_field)
X(FieldInitExpr, NodeKind::Expr_FieldInit, ast::FieldInitExpr*,        alloc_field_init,    fill_field_init)


X(Literal,       NodeKind::Expr_Literal,      ast::LiteralExpr*,      alloc_expr_lit,  fill_expr_lit)

// Types
X(BuiltinType,  NodeKind::Expr_Type,     ast::TypeExpr*,     alloc_expr_type,  fill_expr_type)
