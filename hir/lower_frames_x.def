// allocate_frames_x.def
// X(Tag, NodeKindCase, AstPtrType, FrameDataType, LowerFuncName)

X(Module,       NodeKind::Decl_Module,      ast::Module*,            ModuleFrame,        allocate_module,        fill_module)
X(Import,       NodeKind::Decl_Import,      ast::ImportDecl*,        ImportFrame,        allocate_import,        fill_import)

X(FnDecl,       NodeKind::Decl_Fn,          ast::FunctionDecl*,      FnDeclFrame,        allocate_fndecl,        fill_fndecl)
X(StructDecl,   NodeKind::Decl_Struct,      ast::StructDecl*,        StructDeclFrame,    allocate_structdecl,    fill_structdecl)
X(TypeAlias,    NodeKind::Decl_TypeAlias,   ast::TypeAliasDecl*,     TypeAliasFrame,     allocate_typealias,     fill_typealias)

X(BlockStmt,    NodeKind::Stmt_Block,       ast::BlockStatement*,    BlockFrame,         allocate_block,         fill_block)
X(IfStmt,       NodeKind::Stmt_If,          ast::IfStatement*,       IfFrame,            allocate_if,            fill_if)
X(ElseIfStmt,   NodeKind::Stmt_ElseIf,      ast::ElseIfStatement*,   ElseIfFrame,        allocate_elseif,        fill_elseif)
X(ElseStmt,     NodeKind::Stmt_Else,        ast::ElseStatement*,     ElseFrame,          allocate_else,          fill_else)
X(WhileStmt,    NodeKind::Stmt_While,       ast::WhileStatement*,    WhileFrame,         allocate_while,         fill_while)
X(DoWhileStmt,  NodeKind::Stmt_DoWhile,     ast::DoWhileStatement*,  DoWhileFrame,       allocate_dowhile,       fill_dowhile)
X(ReturnStmt,   NodeKind::Stmt_Return,      ast::ReturnStatement*,   ReturnFrame,        allocate_return,        fill_return)
X(VarDeclStmt,  NodeKind::Stmt_VarDecl,     ast::VarDeclStatement*,  VarDeclStmtFrame,   allocate_vardecl_stmt,  fill_vardecl_stmt)
X(ExprStmt,     NodeKind::Stmt_Expr,        ast::ExprStatement*,     ExprStmtFrame,      allocate_expr_stmt,     fill_expr_stmt)

X(PathExpr,     NodeKind::Expr_Path,        ast::PathExpr*,          PathExprFrame,      allocate_path_expr,     fill_path_expr)
X(RefExpr,      NodeKind::Expr_Ref,         ast::RefExpr*,           RefExprFrame,       allocate_ref_expr,      fill_ref_expr)
X(CallExpr,     NodeKind::Expr_Call,        ast::CallExpr*,          CallFrame,          allocate_call,          fill_call)
X(StructLit,    NodeKind::Expr_StructLit,   ast::StructLiteralExpr*, StructLitFrame,     allocate_struct_lit,    fill_struct_lit)
X(CastExpr,     NodeKind::Expr_Cast,        ast::CastExpr*,          CastFrame,          allocate_cast,          fill_cast)
X(UnaryExpr,    NodeKind::Expr_Unary,       ast::UnaryExpr*,         UnaryFrame,         allocate_unary,         fill_unary)
X(BinaryExpr,   NodeKind::Expr_Binary,      ast::BinaryExpr*,        BinaryFrame,        allocate_binary,        fill_binary)
X(AssignExpr,   NodeKind::Expr_Assign,      ast::AssignExpr*,        AssignFrame,        allocate_assign,        fill_assign)
X(IndexExpr,    NodeKind::Expr_Index,       ast::IndexExpr*,         IndexFrame,         allocate_index,         fill_index)
X(FieldExpr,    NodeKind::Expr_Field,       ast::FieldExpr*,         FieldFrame,         allocate_field,         fill_field)

X(IntLit,       NodeKind::Expr_IntLit,      ast::IntLiteralExpr*,    IntLitFrame,        allocate_int_lit,       fill_int_lit)
X(FloatLit,     NodeKind::Expr_FloatLit,    ast::FloatLiteralExpr*,  FloatLitFrame,      allocate_float_lit,     fill_float_lit)
X(BoolLit,      NodeKind::Expr_BoolLit,     ast::BoolLiteralExpr*,   BoolLitFrame,       allocate_bool_lit,      fill_bool_lit)
X(CharLit,      NodeKind::Expr_CharLit,     ast::CharLiteralExpr*,   CharLitFrame,       allocate_char_lit,      fill_char_lit)
X(StrLit,       NodeKind::Expr_StringLit,   ast::StringLiteralExpr*, StrLitFrame,        allocate_str_lit,       fill_str_lit)

// Types
X(BuiltinType,  NodeKind::Type_Builtin,     ast::BuiltinTypeExpr*,   BuiltinTypeFrame,   allocate_builtin_type,  fill_builtin_type)
X(PathType,     NodeKind::Type_Path,        ast::PathTypeExpr*,      PathTypeFrame,      allocate_path_type,     fill_path_type)
X(RefType,      NodeKind::Type_Ref,         ast::RefTypeExpr*,       RefTypeFrame,       allocate_ref_type,      fill_ref_type)
X(ArrayType,    NodeKind::Type_Array,       ast::ArrayTypeExpr*,     ArrayTypeFrame,     allocate_array_type,    fill_array_type)
