package kolya::s::kolya;

import kolya::kolya as klkl;
import kolka::math::linalg as math;

struct B {
    a: i32;
}

fn local_shadowing_and_copies() -> void {
    v: i32 = 1 as i32;
    {
        v: i32 = 2 as i32;    // shadowing
        w: i32 = v;           // copy from inner v
    }
    t: i32 = v;               // copy from outer v
    return;
}

fn if_else_elseif_logic() -> void {
    a: i32 = 3 as i32;
    b: i32 = 7 as i32;

    // && short-circuit (emit_logical_and)
    if ((a < b) && (b < (100 as i32))) {
        x: i32 = 1 as i32;
    } else if ((a == b) || (a != b)) { // || short-circuit (emit_logical_or)
        y: i32 = 2 as i32;
    } else {
        z: i32 = 3 as i32;
    }

    // logical_not (emit_unary: !)
    if (!(a < b)) {
        q: i32 = 0 as i32;
    }

    return;
}

fn while_and_do_while() -> void {
    mut i: i32 = 0 as i32;

    while (i < (3 as i32)) {
        // i = i + 1
        i = i + (1 as i32);
    }

    do {
        i = i + (1 as i32);
    } while (i < (5 as i32));

    return;
}

fn unary_negation_smoke() -> void {
    // requires emit_unary(U::negation) => rt_neg(Obj*)
    x: i32 = 12 as i32;
    y: i32 = -x;
    z: i32 = -(-y);
    return;
}

fn ref_smoke_mut() -> void {
    // This function is designed to force:
    //  - &mut local -> rt_ref_from_slot(slot_addr)
    //  - *ref load  -> rt_ref_load(ref_obj)
    //  - *ref store -> rt_ref_store(ref_obj, value_obj)

    mut b: i32 = 12 as i32;
    mut pepe: i32 = 34 as i32;

    // addr_of_mut
    mut c: &mut i32 = &mut b;

    // deref store
    *c = b;

    // rebind ref (slot assignment of Obj* ref object)
    c = &mut pepe;

    // deref load
    klawd: i32 = *c;

    // use deref load in expression
    sum: i32 = (*c) + b;

    // another store through ref
    *c = sum;

    return;
}

fn struct_literals_smoke() -> void {
    // empty struct literal
    j: S = S{};

    // consume through imported package function (CallExpr -> GlobalFn)
    klkl::consume_s(j);

    // If your "struct fields + named init" are supported, keep this.
    // It should drive rt_struct_new + rt_struct_set_field calls.
    p: klkl::Point = klkl::Point{ x: 1 as i32, y: 2 as i32 };
    klkl::consume_point(p);

    return;
}

fn numeric_ops_smoke() -> void {
    a: i32 = 41 as i32;
    b: i32 = 2 as i32;

    addv: i32 = a + b;
    subv: i32 = a - b;
    mulv: i32 = a * b;
    divv: i32 = a / b;
    modv: i32 = a % b;

    // comparisons (Obj*,Obj*) -> i1
    c1: bool = (a == b);
    c2: bool = (a != b);
    c3: bool = (a < b);
    c4: bool = (a <= b);
    c5: bool = (a > b);
    c6: bool = (a >= b);

    // use bools in control flow (unbox if needed)
    if (c3) {
        t: i32 = addv;
    } else {
        t: i32 = subv;
    }

    return;
}

fn float_literals_smoke() -> i32 {
    // requires Pass7 float lowering + rt_float_from_f32/f64
    f1: f32 = 1.25 as f32;
    f2: f64 = 2.5 as f64;

    // just bind/copy to force value flow
    g1: f32 = f1;
    g2: f64 = f2;

    return 15;
}

fn stress_refs() -> void
{
    mut i: i32 = 0 as i32;

    while (i < 200000 as i32)
    {
        mut a: i32 = i;
        mut b: i32 = (i + 1 as i32);

        // Create &mut and overwrite it many times.
        mut r: &mut i32 = &mut a;

        // Mutation through deref.
        *r = (*r + 1 as i32);

        // Rebind r back and forth: this stresses "assign ref object" ARC.
        r = &mut b;
        *r = (*r + 2 as i32);

        r = &mut a;
        *r = (*r + 3 as i32);

        // Create many temporary refs that should die immediately (ExprStatement path).
        &mut a;
        &mut a;
        &mut b;
        &mut b;

        // Nested scopes + shadowing (scope teardown correctness).
        {
            mut t: &mut i32 = &mut a;
            *t = (*t + 4 as i32);
            t = &mut b;
            *t = (*t + 5 as i32);
        }

        // Keep loop from being optimized away (also tests print arg is &T).
        // If print is expensive, you can guard it:
        if ((i % 50000 as i32) == 0 as i32) {
            mut v: i32 = a;
            print::<i32>(&v);
        }

        i = (i + 1 as i32);
    }
}

fn stress_boxes_and_indexing() -> void
{
    mut i: i32 = 0 as i32;

    while (i < 20000 as i32)
    {
        // Box + &mut Box paths (materialize_value_if_ref for box_set/box_get)
        mut bx: Box::<i64> = box_new::<i64>(64 as i64);

        // Fill via &mut
        mut j: i64 = 0 as i64;
        while (j < 64 as i64)
        {
            box_set::<i64>(&mut bx, j, (j + 123 as i64));
            j = (j + 1 as i64) ;
        }

        // Read back
        mut sum: i64 = 0 as i64;
        j = 0 as i64;
        while (j < 64 as i64)
        {
            mut x: i64 = box_get::<i64>(&mut bx, j);
            sum = (sum + x) ;
            j = (j + 1 as i64);
        }

        // Create/destroy temporary refs to the box slot (must not retain box contents)
        &mut bx;
        &mut bx;

        // Optional: drop box explicitly if you want to exercise box_free too:
        // box_free::<i64>(&mut bx);

        // prevent DCE
        if ((i % 5000 as i32) == 0 as i32) {
            mut s_i32: i32 = 0 as i32; // placeholder; adapt if you have i64 print
            // print::<i32>(&s_i32);
        }

        i = (i + 1 as i32);
    }
}

