fn s(in: &mut i32, out: &mut i32) -> void {
    *in = 2 as i32 * *in;
    *out = *in;
}

pub fn main() -> void {
    mut i: i32 = 1 as i32;
    mut o: i32 = 10 as i32;
    mut out: i32 = o;
    /*
    if (false) {
        print::<i32>(&o);
    } else if (true) {
        o = 16 as i32;
        print::<i32>(&o);
    }

    print::<i32>(&o);
    print::<i32>(&out);

    print::<i32>(&i);
    i = i + 1 as i32;

    s(&mut i, &mut out);

    print::<i32>(&i);

    print::<i32>(&out);


    //decl();
    mut a: math::MatrixI32 = math::mat_i32_new(2 as i64, 3 as i64);
    mut b: math::MatrixI32 = math::mat_i32_new(2 as i64, 3 as i64);

    math::mat_i32_set_base(&mut a, 0 as i64, 0 as i64, 1 as i32);
    math::mat_i32_set_base(&mut a, 0 as i64, 1 as i64, 2 as i32);
    math::mat_i32_set_base(&mut a, 0 as i64, 2 as i64, 3 as i32);
    math::mat_i32_set_base(&mut a, 1 as i64, 0 as i64, 4 as i32);
    math::mat_i32_set_base(&mut a, 1 as i64, 1 as i64, 5 as i32);
    math::mat_i32_set_base(&mut a, 1 as i64, 2 as i64, 6 as i32);

    // Fill B = [[10,10,10],[1,2,3]]
    math::mat_i32_set_base(&mut b, 0 as i64, 0 as i64, 10 as i32);
    math::mat_i32_set_base(&mut b, 0 as i64, 1 as i64, 10 as i32);
    math::mat_i32_set_base(&mut b, 0 as i64, 2 as i64, 10 as i32);
    math::mat_i32_set_base(&mut b, 1 as i64, 0 as i64, 1 as i32);
    math::mat_i32_set_base(&mut b, 1 as i64, 1 as i64, 2 as i32);
    math::mat_i32_set_base(&mut b, 1 as i64, 2 as i64, 3 as i32);

    mut id3: math::MatrixI32 = math::mat_i32_new(3 as i64, 3 as i64);
    math::mat_i32_identity_base(&mut id3, 3 as i64);

    // Expected prints: 1, 0, 1
    mut id00: i32 = math::mat_i32_get_base(&id3, 0 as i64, 0 as i64);
    print::<i32>(&id00);

    mut id01: i32 = math::mat_i32_get_base(&id3, 0 as i64, 1 as i64);
    print::<i32>(&id01);

    mut id22: i32 = math::mat_i32_get_base(&id3, 2 as i64, 2 as i64);
    print::<i32>(&id22);

    // Diagonal extract from A (2x3) => [A00, A11] as 2x1
    mut diagA: math::MatrixI32 = math::mat_i32_new(2 as i64, 1 as i64);
    math::mat_i32_diag_extract_base(&mut diagA, &a);

    // Expected prints: 1, 5
    mut d0: i32 = math::mat_i32_get_base(&diagA, 0 as i64, 0 as i64);
    print::<i32>(&d0);

    mut d1: i32 = math::mat_i32_get_base(&diagA, 1 as i64, 0 as i64);
    print::<i32>(&d1);

    // ------------------------------------------------------------
    // Hadamard + scalar ops (I32)
    // ------------------------------------------------------------
    mut out_had: math::MatrixI32 = math::mat_i32_new(2 as i64, 3 as i64);
    math::mat_i32_hadamard_base(&mut out_had, &a, &b);
    llll: char = 's';
    print::<char>(&llll);

    // A .* B where
    // A = [[1,2,3],[4,5,6]]
    // B = [[10,10,10],[1,2,3]]
    // => [[10,20,30],[4,10,18]]
    // Expected prints: 30, 10
    mut h02: i32 = math::mat_i32_get_base(&out_had, 0 as i64, 2 as i64);
    print::<i32>(&h02);

    mut h11: i32 = math::mat_i32_get_base(&out_had, 1 as i64, 1 as i64);
    print::<i32>(&h11);

    // out_add5 = A + 5
    mut out_add5: math::MatrixI32 = math::mat_i32_new(2 as i64, 3 as i64);
    math::mat_i32_add_scalar_base(&mut out_add5, &a, 5 as i32);
    // Expected print: 8  (A[0,2]=3 -> 3+5=8)
    mut a02p5: i32 = math::mat_i32_get_base(&out_add5, 0 as i64, 2 as i64);
    print::<i32>(&a02p5);

    // out_sub1 = A - 1
    mut out_sub1: math::MatrixI32 = math::mat_i32_new(2 as i64, 3 as i64);
    math::mat_i32_sub_scalar_base(&mut out_sub1, &a, 1 as i32);
    // Expected print: 3  (A[1,0]=4 -> 4-1=3)
    mut a10m1: i32 = math::mat_i32_get_base(&out_sub1, 1 as i64, 0 as i64);
    print::<i32>(&a10m1);

    // ------------------------------------------------------------
    // Neg / Abs (I32)
    // ------------------------------------------------------------
    mut vi: math::MatrixI32 = math::mat_i32_new(1 as i64, 3 as i64);
    math::mat_i32_set_base(&mut vi, 0 as i64, 0 as i64, -1 as i32);
    math::mat_i32_set_base(&mut vi, 0 as i64, 1 as i64, 0 as i32);
    math::mat_i32_set_base(&mut vi, 0 as i64, 2 as i64, 2 as i32);

    mut vi_abs: math::MatrixI32 = math::mat_i32_new(1 as i64, 3 as i64);
    math::mat_i32_abs_base(&mut vi_abs, &vi);
    // Expected prints: 1, 0, 2
    mut ab0: i32 = math::mat_i32_get_base(&vi_abs, 0 as i64, 0 as i64);
    print::<i32>(&ab0);
    mut ab1: i32 = math::mat_i32_get_base(&vi_abs, 0 as i64, 1 as i64);
    print::<i32>(&ab1);
    mut ab2: i32 = math::mat_i32_get_base(&vi_abs, 0 as i64, 2 as i64);
    print::<i32>(&ab2);

    mut vi_neg: math::MatrixI32 = math::mat_i32_new(1 as i64, 3 as i64);
    math::mat_i32_neg_base(&mut vi_neg, &vi);
    // Expected prints: 1, 0, -2
    mut ng0: i32 = math::mat_i32_get_base(&vi_neg, 0 as i64, 0 as i64);
    print::<i32>(&ng0);
    mut ng1: i32 = math::mat_i32_get_base(&vi_neg, 0 as i64, 1 as i64);
    print::<i32>(&ng1);
    mut ng2: i32 = math::mat_i32_get_base(&vi_neg, 0 as i64, 2 as i64);
    print::<i32>(&ng2);

    // ------------------------------------------------------------
    // Reductions (I32) on A = [[1,2,3],[4,5,6]]
    // ------------------------------------------------------------
    // sum = 21, min = 1, max = 6, trace = 1+5 = 6
    mut sA: i64 = math::mat_i32_sum_base(&a);
    print::<i64>(&sA);

    mut mnA: i32 = math::mat_i32_min_base(&a);
    print::<i32>(&mnA);

    mut mxA: i32 = math::mat_i32_max_base(&a);
    print::<i32>(&mxA);

    mut trA: i64 = math::mat_i32_trace_base(&a);
    print::<i64>(&trA);

    // ============================================================
    // F64 checks
    // ============================================================

    // ------------------------------------------------------------
    // diag_from_vec (F64): v=[1,2,3] -> D is 3x3 diagonal
    // ------------------------------------------------------------
    mut vf: math::MatrixF64 = math::mat_f64_new(3 as i64, 1 as i64);
    math::mat_f64_set_base(&mut vf, 0 as i64, 0 as i64, 1.0 as f64);
    math::mat_f64_set_base(&mut vf, 1 as i64, 0 as i64, 2.0 as f64);
    math::mat_f64_set_base(&mut vf, 2 as i64, 0 as i64, 3.0 as f64);

    mut D: math::MatrixF64 = math::mat_f64_new(3 as i64, 3 as i64);
    math::mat_f64_diag_from_vec_base(&mut D, &vf);

    // Expected prints: 3.0, 0.0
    mut d22f: f64 = math::mat_f64_get_base(&D, 2 as i64, 2 as i64);
    print::<f64>(&d22f);

    mut d01f: f64 = math::mat_f64_get_base(&D, 0 as i64, 1 as i64);
    print::<f64>(&d01f);

    // ------------------------------------------------------------
    // hadamard_div (F64): [[2,4],[6,8]] ./ [[1,2],[3,4]] => all 2.0
    // ------------------------------------------------------------
    mut ha: math::MatrixF64 = math::mat_f64_new(2 as i64, 2 as i64);
    mut hb: math::MatrixF64 = math::mat_f64_new(2 as i64, 2 as i64);

    math::mat_f64_set_base(&mut ha, 0 as i64, 0 as i64, 2.0 as f64);
    math::mat_f64_set_base(&mut ha, 0 as i64, 1 as i64, 4.0 as f64);
    math::mat_f64_set_base(&mut ha, 1 as i64, 0 as i64, 6.0 as f64);
    math::mat_f64_set_base(&mut ha, 1 as i64, 1 as i64, 8.0 as f64);

    math::mat_f64_set_base(&mut hb, 0 as i64, 0 as i64, 1.0 as f64);
    math::mat_f64_set_base(&mut hb, 0 as i64, 1 as i64, 2.0 as f64);
    math::mat_f64_set_base(&mut hb, 1 as i64, 0 as i64, 3.0 as f64);
    math::mat_f64_set_base(&mut hb, 1 as i64, 1 as i64, 4.0 as f64);

    mut hdiv: math::MatrixF64 = math::mat_f64_new(2 as i64, 2 as i64);
    math::mat_f64_hadamard_div_base(&mut hdiv, &ha, &hb);

    // Expected prints: 2.0, 2.0
    mut hd01: f64 = math::mat_f64_get_base(&hdiv, 0 as i64, 1 as i64);
    print::<f64>(&hd01);
    mut hd10: f64 = math::mat_f64_get_base(&hdiv, 1 as i64, 0 as i64);
    print::<f64>(&hd10);

    // ------------------------------------------------------------
    // Elementwise trig / exp / log / sqrt (use values with exact outputs)
    // ------------------------------------------------------------
    mut z1: math::MatrixF64 = math::mat_f64_new(1 as i64, 1 as i64);
    math::mat_f64_set_base(&mut z1, 0 as i64, 0 as i64, 0.0 as f64);

    mut o1: math::MatrixF64 = math::mat_f64_new(1 as i64, 1 as i64);
    math::mat_f64_set_base(&mut o1, 0 as i64, 0 as i64, 1.0 as f64);

    mut n9: math::MatrixF64 = math::mat_f64_new(1 as i64, 1 as i64);
    math::mat_f64_set_base(&mut n9, 0 as i64, 0 as i64, 9.0 as f64);

    mut out_sin: math::MatrixF64 = math::mat_f64_new(1 as i64, 1 as i64);
    math::mat_f64_sin_base(&mut out_sin, &z1);
    // Expected: 0.0
    mut sin0: f64 = math::mat_f64_get_base(&out_sin, 0 as i64, 0 as i64);
    print::<f64>(&sin0);

    mut out_cos: math::MatrixF64 = math::mat_f64_new(1 as i64, 1 as i64);
    math::mat_f64_cos_base(&mut out_cos, &z1);
    // Expected: 1.0
    mut cos0: f64 = math::mat_f64_get_base(&out_cos, 0 as i64, 0 as i64);
    print::<f64>(&cos0);

    mut out_exp: math::MatrixF64 = math::mat_f64_new(1 as i64, 1 as i64);
    math::mat_f64_exp_base(&mut out_exp, &z1);
    // Expected: 1.0
    mut exp0: f64 = math::mat_f64_get_base(&out_exp, 0 as i64, 0 as i64);
    print::<f64>(&exp0);

    mut out_log: math::MatrixF64 = math::mat_f64_new(1 as i64, 1 as i64);
    math::mat_f64_log_base(&mut out_log, &o1);
    // Expected: 0.0
    mut log1: f64 = math::mat_f64_get_base(&out_log, 0 as i64, 0 as i64);
    print::<f64>(&log1);

    mut out_sqrt: math::MatrixF64 = math::mat_f64_new(1 as i64, 1 as i64);
    math::mat_f64_sqrt_base(&mut out_sqrt, &n9);
    // Expected: 3.0
    mut sqrt9: f64 = math::mat_f64_get_base(&out_sqrt, 0 as i64, 0 as i64);
    print::<f64>(&sqrt9);

    // ------------------------------------------------------------
    // clamp / floor / ceil / round
    // ------------------------------------------------------------
    mut fx: math::MatrixF64 = math::mat_f64_new(1 as i64, 3 as i64);
    math::mat_f64_set_base(&mut fx, 0 as i64, 0 as i64, -1.0 as f64);
    math::mat_f64_set_base(&mut fx, 0 as i64, 1 as i64, 0.5 as f64);
    math::mat_f64_set_base(&mut fx, 0 as i64, 2 as i64, 2.0 as f64);

    mut fx_cl: math::MatrixF64 = math::mat_f64_new(1 as i64, 3 as i64);
    math::mat_f64_clamp_base(&mut fx_cl, &fx, 0.0 as f64, 1.0 as f64);
    // Expected prints: 0.0, 0.5, 1.0
    mut cl0: f64 = math::mat_f64_get_base(&fx_cl, 0 as i64, 0 as i64);
    print::<f64>(&cl0);
    mut cl1: f64 = math::mat_f64_get_base(&fx_cl, 0 as i64, 1 as i64);
    print::<f64>(&cl1);
    mut cl2: f64 = math::mat_f64_get_base(&fx_cl, 0 as i64, 2 as i64);
    print::<f64>(&cl2);

    mut fr: math::MatrixF64 = math::mat_f64_new(1 as i64, 3 as i64);
    math::mat_f64_set_base(&mut fr, 0 as i64, 0 as i64, 1.2 as f64);
    math::mat_f64_set_base(&mut fr, 0 as i64, 1 as i64, -1.2 as f64);
    math::mat_f64_set_base(&mut fr, 0 as i64, 2 as i64, 2.9 as f64);

    mut fr_floor: math::MatrixF64 = math::mat_f64_new(1 as i64, 3 as i64);
    math::mat_f64_floor_base(&mut fr_floor, &fr);
    // Expected prints: 1.0, -2.0, 2.0
    mut f0: f64 = math::mat_f64_get_base(&fr_floor, 0 as i64, 0 as i64);
    print::<f64>(&f0);
    mut f1: f64 = math::mat_f64_get_base(&fr_floor, 0 as i64, 1 as i64);
    print::<f64>(&f1);
    mut f2: f64 = math::mat_f64_get_base(&fr_floor, 0 as i64, 2 as i64);
    print::<f64>(&f2);

    mut fr_ceil: math::MatrixF64 = math::mat_f64_new(1 as i64, 3 as i64);
    math::mat_f64_ceil_base(&mut fr_ceil, &fr);
    // Expected prints: 2.0, -1.0, 3.0
    mut c0: f64 = math::mat_f64_get_base(&fr_ceil, 0 as i64, 0 as i64);
    print::<f64>(&c0);
    mut c1: f64 = math::mat_f64_get_base(&fr_ceil, 0 as i64, 1 as i64);
    print::<f64>(&c1);
    mut c2: f64 = math::mat_f64_get_base(&fr_ceil, 0 as i64, 2 as i64);
    print::<f64>(&c2);

    mut fr_round: math::MatrixF64 = math::mat_f64_new(1 as i64, 3 as i64);
    math::mat_f64_round_base(&mut fr_round, &fr);
    // Expected prints: 1.0, -1.0, 3.0
    mut r0: f64 = math::mat_f64_get_base(&fr_round, 0 as i64, 0 as i64);
    print::<f64>(&r0);
    mut r1: f64 = math::mat_f64_get_base(&fr_round, 0 as i64, 1 as i64);
    print::<f64>(&r1);
    mut r2: f64 = math::mat_f64_get_base(&fr_round, 0 as i64, 2 as i64);
    print::<f64>(&r2);

    // ------------------------------------------------------------
    // Norms (use matrix with exact Frobenius = 5)
    // M = [[3,4],[0,0]]
    // fro = 5, norm1 = 4, norm_inf = 7
    // ------------------------------------------------------------
    mut nm: math::MatrixF64 = math::mat_f64_new(2 as i64, 2 as i64);
    math::mat_f64_set_base(&mut nm, 0 as i64, 0 as i64, 3.0 as f64);
    math::mat_f64_set_base(&mut nm, 0 as i64, 1 as i64, 4.0 as f64);
    math::mat_f64_set_base(&mut nm, 1 as i64, 0 as i64, 0.0 as f64);
    math::mat_f64_set_base(&mut nm, 1 as i64, 1 as i64, 0.0 as f64);

    mut nf: f64 = math::mat_f64_norm_fro_base(&nm);
    print::<f64>(&nf);

    mut n1: f64 = math::mat_f64_norm1_base(&nm);
    print::<f64>(&n1);

    mut ni: f64 = math::mat_f64_norm_inf_base(&nm);
    print::<f64>(&ni);

    // ------------------------------------------------------------
    // det / inv (F64) on [[1,2],[3,4]]
    // det = -2
    // inv = [[-2, 1],[1.5, -0.5]]
    // ------------------------------------------------------------
    mut A2: math::MatrixF64 = math::mat_f64_new(2 as i64, 2 as i64);
    math::mat_f64_set_base(&mut A2, 0 as i64, 0 as i64, 1.0 as f64);
    math::mat_f64_set_base(&mut A2, 0 as i64, 1 as i64, 2.0 as f64);
    math::mat_f64_set_base(&mut A2, 1 as i64, 0 as i64, 3.0 as f64);
    math::mat_f64_set_base(&mut A2, 1 as i64, 1 as i64, 4.0 as f64);

    mut detA2: f64 = math::mat_f64_det_base(&A2);
    print::<f64>(&detA2);

    mut invA2: math::MatrixF64 = math::mat_f64_new(2 as i64, 2 as i64);
    math::mat_f64_inv_base(&mut invA2, &A2);

    // Expected prints: -2.0, 1.5
    mut inv00: f64 = math::mat_f64_get_base(&invA2, 0 as i64, 0 as i64);
    print::<f64>(&inv00);
    mut inv10: f64 = math::mat_f64_get_base(&invA2, 1 as i64, 0 as i64);
    print::<f64>(&inv10);

    // ------------------------------------------------------------
    // solve (F64): [[3,1],[1,2]] * x = [[9],[8]]  => x = [[2],[3]]
    // ------------------------------------------------------------
    mut As: math::MatrixF64 = math::mat_f64_new(2 as i64, 2 as i64);
    math::mat_f64_set_base(&mut As, 0 as i64, 0 as i64, 3.0 as f64);
    math::mat_f64_set_base(&mut As, 0 as i64, 1 as i64, 1.0 as f64);
    math::mat_f64_set_base(&mut As, 1 as i64, 0 as i64, 1.0 as f64);
    math::mat_f64_set_base(&mut As, 1 as i64, 1 as i64, 2.0 as f64);

    mut Bs: math::MatrixF64 = math::mat_f64_new(2 as i64, 1 as i64);
    math::mat_f64_set_base(&mut Bs, 0 as i64, 0 as i64, 9.0 as f64);
    math::mat_f64_set_base(&mut Bs, 1 as i64, 0 as i64, 8.0 as f64);

    mut Xs: math::MatrixF64 = math::mat_f64_new(2 as i64, 1 as i64);
    math::mat_f64_solve_base(&mut Xs, &As, &Bs);

    // Expected prints: 2.0, 3.0
    mut x0: f64 = math::mat_f64_get_base(&Xs, 0 as i64, 0 as i64);
    print::<f64>(&x0);
    mut x1: f64 = math::mat_f64_get_base(&Xs, 1 as i64, 0 as i64);
    print::<f64>(&x1);

    // ------------------------------------------------------------
    // dot (F64): [1,2,3]·[4,5,6] = 32
    // (vectors are 1x3 here; n×1 also accepted)
    // ------------------------------------------------------------
    mut v1: math::MatrixF64 = math::mat_f64_new(1 as i64, 3 as i64);
    mut v2: math::MatrixF64 = math::mat_f64_new(1 as i64, 3 as i64);
    math::mat_f64_set_base(&mut v1, 0 as i64, 0 as i64, 1.0 as f64);
    math::mat_f64_set_base(&mut v1, 0 as i64, 1 as i64, 2.0 as f64);
    math::mat_f64_set_base(&mut v1, 0 as i64, 2 as i64, 3.0 as f64);

    math::mat_f64_set_base(&mut v2, 0 as i64, 0 as i64, 4.0 as f64);
    math::mat_f64_set_base(&mut v2, 0 as i64, 1 as i64, 5.0 as f64);
    math::mat_f64_set_base(&mut v2, 0 as i64, 2 as i64, 6.0 as f64);

    mut dot12: f64 = math::mat_f64_dot_base(&v1, &v2);
    print::<f64>(&dot12);
    */

    mut cruel_box: Box::<bool>;
    cruel_box = box_new::<bool>(1000 as i64);
    len: i64 = box_len::<bool>(&cruel_box);

    mut a: i64 = 0 as i64;
    while (a < len) {
       box_set::<bool>(&mut cruel_box, a, true);

       a = a + 1 as i64;
    }

    mut j: i64 = 0 as i64;

    while (j < len) {
       i: bool = box_get::<bool>(&mut cruel_box, j);
       print::<bool>(&i);
       j = j + 1 as i64;
    }

    //print::<i32>(1 as i32);
    //print::<i32>(&a);
    cool(1 as i32);
}

fn bad() -> &i32 {
    a: i32 = 100 as i32;

    return &a;
}

fn cool(a: i32) -> void {
    c: &i32 = bad();
}

