// 99_all_features.kl
// Intentionally broad coverage for parser regression testing.
package demo::all;

import std::io;
import foo::bar as baz;

struct Empty;

pub struct Point<T,> {
  x: i32;
  pub y: i32;
}

fn add(a: i32, b: i32,) -> i32;

pub fn id<T,>(t: T,) -> T {
  return t;
}

fn main() -> i32 {
  // -------------------------
  // Variable declarations
  // -------------------------
  imm x: i32 = 1;
  mut y: i32 = 2;
  imm z: i32 = 3;

  some::very::long::path::to.function();
  some::very::long::path::to::function();

  // -------------------------
  // Literals (incl. suffixes)
  // -------------------------
  imm i: i32 = 123 as i16;
  imm f: f64 = 3.14 as f64;
  imm b: bool = true;
  imm c: char = 'c';
  imm s: Str = "hello";

  // -------------------------
  // Types: array + ref
  // -------------------------
  imm arr: i32[10];
  imm r: &mut i32;
  imm s: s[10];

  // -------------------------
  // Struct literal (+ trailing comma)
  // -------------------------
  imm p: Point = Point{
    x: 10,
    y: 20,
  };

  // -------------------------
  // Expressions / operators
  // -------------------------

  imm y: i8;
  y += (x + 2) * 3;
  y = y - -1;
  y = y % 2;

  // unary logical-not
  nb: bool = !false;
  // -------------------------
  // Calls (with type args + trailing commas)
  // -------------------------
  imm t0: i32 = some::hello::id::<S,>{};
  imm t1: i32 = id(y);
  imm t2: i32 = id::<i32,>(y,);

  // post/pre inc/dec
  y++;
  --y;

  // indexing + field access
  imm u: i32 = arr[1] + p.x;

  // expr statement
  id(u);

  // -------------------------
  // if / else-if / else
  // -------------------------
  if (y > 0 && true || false) {
    y = y - 1;
  }
  else if (y == 0) {
    y = y + 1;
  }
  else {
    y = 0;
  }

  // -------------------------
  // while + break/continue
  // -------------------------
  while (y < 5) {
    y += 1;

    if (y == 3) { continue; }
    if (y == 4) { break; }
  }

  // -------------------------
  // do-while
  // -------------------------
  do {
    y -= 1;
  } while (y > 0);

  return y;
}
