// Showcase: typy wbudowane i konwersje
package showcase::types;

pub fn main() -> void {
    // === TYPY CAŁKOWITE ===
    a_i32: i32 = 42 as i32;
    a_i64: i64 = 9999999999 as i64;
    a_i8: i8 = 127 as i8;
    
    // === TYPY ZMIENNOPRZECINKOWE ===
    f_f32: f32 = 3.14 as f32;
    f_f64: f64 = 2.718281828 as f64;
    
    // === BOOL ===
    flag_true: bool = true;
    flag_false: bool = false;
    
    // === CHAR ===
    ch: char = 'A';
    newline: char = '\n';
    
    // Użycie w wyrażeniach
    mut sum: i32 = a_i32 + (10 as i32);
    print::<i32>(&sum);
    
    // Operacje zmiennoprzecinkowe
    mut product: f64 = f_f64 * (2.0 as f64);
    print::<f64>(&product);
    
    // Porównania zwracające bool
    is_positive: bool = (a_i32 > (0 as i32));
    print::<bool>(&is_positive);
    
    // Operatory arytmetyczne
    mut add_result: i32 = a_i32 + (8 as i32);
    mut sub_result: i32 = a_i32 - (2 as i32);
    mut mul_result: i32 = a_i32 * (2 as i32);
    mut div_result: i32 = a_i32 / (2 as i32);
    mut mod_result: i32 = a_i32 % (5 as i32);
    
    print::<i32>(&add_result);
    print::<i32>(&sub_result);
    print::<i32>(&mul_result);
    print::<i32>(&div_result);
    print::<i32>(&mod_result);
    
    // Negacja
    mut neg: i32 = -a_i32;
    print::<i32>(&neg);
    
    return;
}
