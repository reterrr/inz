// Showcase: struktury z polami i inicjalizacja
package showcase::structs;

struct Point {
    x: i32;
    y: i32;
}

pub struct Rectangle {
    pub width: i32;
    pub height: i32;
}

fn create_point(x: i32, y: i32) -> Point {
    p: Point = Point{ x: x, y: y };
    return p;
}

pub fn main() -> void {
    // Inicjalizacja struktury
    p: Point = create_point(10 as i32, 20 as i32);
    
    // Dostęp do pól
    mut px: i32 = p.x;
    print::<i32>(&px);
    
    // Struktura publiczna
    r: Rectangle = Rectangle{ width: 100 as i32, height: 50 as i32 };
    mut w: i32 = r.width;
    print::<i32>(&w);
    
    return;
}
