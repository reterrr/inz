// Showcase: funkcje - argumenty, zwracanie wartości, wywołania
package showcase::functions;

// Funkcja bez argumentów
fn get_magic_number() -> i32 {
    return 42 as i32;
}

// Funkcja z argumentami
fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

// Funkcja z wieloma argumentami
fn sum_three(a: i32, b: i32, c: i32) -> i32 {
    result: i32 = a + b + c;
    return result;
}

// Funkcja void
fn print_value(x: &i32) -> void {
    print::<i32>(x);
    return;
}

pub fn main() -> void {
    // Wywołanie funkcji bez argumentów
    mut magic: i32 = get_magic_number();
    print_value(&magic);
    
    // Wywołanie z argumentami
    mut sum: i32 = add(10 as i32, 20 as i32);
    print_value(&sum);
    
    // Zagnieżdżone wywołania
    mut total: i32 = sum_three(magic, sum, 8 as i32);
    print_value(&total);
    
    return;
}
